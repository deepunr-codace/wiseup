---
import { site } from '../data/site';
import Icon from './Icon.astro';
import Button from './Button.astro';
import { Image } from 'astro:assets';
import logo from '../assets/brand/w-logo-wiseup-branding-v3-1.webp';
// `current` marks a whole page as current (e.g. 'contact' on /contact); on the homepage the nav
// marks sections on scroll instead. `cta` is where the header button points.
interface Props { current?: string; cta?: string }
const { current, cta = '/#contact' } = Astro.props;
const links = [...site.nav.map((n) => ({ label: n.label, id: n.href.split('#')[1] })), { label: 'Contact', id: 'contact' }];
---
<header class="hd" data-head>
  <a class:list={['hd__logo', { 'hd__logo--dark': current === 'about' }]} href="#top" aria-label="WiseUp, back to top">
    <Image src={logo} alt="WiseUp" width={160} height={83} />
  </a>

  <nav class="hd__nav" aria-label="Sections">
    {links.map((l) => (
      <a class:list={['hd__link', { 'is-current': l.id === current }]} href={l.id === current ? `/${l.id}` : `/#${l.id}`} data-nav={l.id} aria-current={l.id === current ? 'page' : undefined}><span class="hd__dot" aria-hidden="true"></span>{l.label}</a>
    ))}
  </nav>

  <div class="hd__actions">
    <button class="hd__theme" type="button" data-theme-toggle aria-label="Switch to light mode" aria-pressed="false">
      <span class="hd__theme-ico">
        <Icon name="moon" size={18} class="ico--moon" />
        <Icon name="sun" size={18} class="ico--sun" />
      </span>
    </button>

    <a class="hd__cta" href={cta}>
      <span class="hd__cta-glow" aria-hidden="true"></span>
      <span class="hd__cta-border" aria-hidden="true"></span>
      <span class="hd__cta-shine" aria-hidden="true"></span>
      <span class="hd__cta-inner"><span class="hd__cta-label">{site.ctaShort}</span></span>
    </a>

    <button class="hd__menu" type="button" aria-expanded="false" aria-controls="menu" data-menu-btn>
      <Icon name="menu" size={18} /><span>Menu</span>
    </button>
  </div>
  <div class="menu" id="menu" hidden data-menu>
    {links.map((l) => <a href={l.id === current ? `/${l.id}` : `/#${l.id}`} aria-current={l.id === current ? 'page' : undefined} data-menu-link><span class="hd__dot" aria-hidden="true"></span>{l.label}</a>)}
    <Button href={cta} label={site.ctaShort} look="teal" block data-menu-link />
  </div>
</header>
