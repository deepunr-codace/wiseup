---
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="ft">
  <p class="ft__word" aria-hidden="true" data-ft-word>WiseUp</p>
  <div class="ft__row">
    <div class="ft__addr">
      <a class="ft__link" href={`mailto:${site.email}`}>{site.email}</a>
      <a class="ft__link" href={site.phoneHref}>{site.phone}</a>
      <p>{site.city}</p>
    </div>
    <ul class="ft__nav">
      {site.socials.map((s) => <li><a class="ft__link" href={s.href} rel="me noopener" target="_blank">{s.label}</a></li>)}
      <li><a class="ft__link" href="https://codeace.com" rel="noopener" target="_blank">CodeAce</a></li>
      <li><span>© {year} WiseUp · {site.footerLine}</span></li>
    </ul>
  </div>
</footer>
