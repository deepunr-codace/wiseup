---
import { readFileSync } from 'node:fs';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import SecHead from '../components/SecHead.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import { testimonials } from '../data/testimonials';
import { site, hero, marquee, about, process, services, clients, projects, work, codeace, faq, contact } from '../data/site';
import aboutPhoto from '../assets/about/team.webp';

// Hero strip: the client testimonial videos repeated so the loop never shows an edge. The same 8 posters
// and 8 MP4s each set; the videos are only fetched for the card being played (see hero-strip-video.ts).
const STRIP_SETS = 4;
const strip = Array.from({ length: STRIP_SETS }, () => testimonials).flat();
// Work rows: same five covers, the second row in a different order so columns never line up.
const ROW_SETS = 3;
const rowA = projects;
const rowB = [projects[3], projects[0], projects[4], projects[2], projects[1]];
const pad = (n: number) => String(n).padStart(2, '0');

// CodeAce figure: one path that morphs CodeAce mark -> WiseUp mark -> flame. The C is the static frame.
const shapeC = 'M156.6 43.4A80 80 0 1 0 156.6 156.6L132.5 132.5A46 46 0 1 1 132.5 67.5Z';

// Hero wordmark: inlined (not <img>) so heroWordmark() in motion/main.ts can animate each
// letter's <path> individually. Generated by scripts/make-hero-wordmark.mjs — re-run that after
// any change to the wordmark text/font, no need to touch width/height here, it's self-contained.
const heroWordmarkSvg = readFileSync(new URL('../../public/brand/hero-wiseup-brush.svg', import.meta.url), 'utf8');
---
<Base>
  <Header slot="header" />

  <!-- HERO: wordmark over a faint orbit, then one tilted strip of work that slides on its own and
       is pushed further along its diagonal by scroll (heroStrip() in motion/main.ts). -->
  <section class="hero" id="top" aria-label="WiseUp">
    <!-- Digital aquarium (heroAqua() in motion/hero-aqua.ts): brand-gradient fluid canvas + rising 3D icons. -->
    <div class="aqua" aria-hidden="true" data-aqua>
      <canvas class="aqua__fluid" data-aqua-fluid></canvas>
      <div class="aqua__icons" data-aqua-icons></div>
    </div>
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="hero__title">
      <div class="hero__orbit" aria-hidden="true" data-orbit><span class="hero__orb"></span></div>
      <div class="hero__art">
        <!-- Hero heading: the brush logo, one traced <path> per letter (scripts/make-brush-wordmark.py),
             built into pure white 3D letters by heroType() in motion/hero-type.ts. -->
        <p class="hero__word" data-wordmark set:html={heroWordmarkSvg} />
      </div>
      <p class="hero__sub" data-reveal="fade" data-intro data-delay="0.45">{hero.eyebrow}</p>
    </div>
    <div class="strip" aria-hidden="true" data-strip>
      <div class="strip__plane">
        <div class="strip__track" data-strip-track data-sets={STRIP_SETS}>
          {strip.map((t, i) => (
            <figure class="strip__card" data-vcard data-video={t.video}>
              <img src={t.poster.src} srcset={t.poster.srcset} sizes="(max-width: 640px) 62vw, 20vw" alt="" width="576" height="1024"
                loading={i < 8 ? 'eager' : 'lazy'} decoding="async" fetchpriority={i === 0 ? 'high' : undefined} />
              <video class="strip__video" muted playsinline preload="none" disablepictureinpicture disableremoteplayback tabindex="-1" aria-hidden="true"></video>
              <span class="strip__load" aria-hidden="true"></span>
            </figure>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- IMAGE SEQUENCE: the flame ignites as the line is read -->
  <section class="seq" id="voice" aria-labelledby="hero-title">
    <!-- Live flame backdrop (flameBackdrop() in motion/flame-backdrop.ts): drawn in the brand palette and ignited by the scroll. -->
    <div class="seq__pin" data-seq>
      <canvas class="seq__canvas" aria-hidden="true" data-flame></canvas>
      <!-- YouTube background (ytBackdrop() in motion/yt-backdrop.ts), fades in over the flame once it is playing. -->
      <div class="seq__yt" aria-hidden="true" data-yt="nccuN47XdbM"></div>
      <div class="seq__shade" aria-hidden="true"></div>
      <div class="wrap seq__copy">
        <h1 id="hero-title" class="seq__line" data-words>
          <span class="seq__a">{hero.line[0]}</span>
          <span class="seq__b">{hero.line[1]}</span>
          <span class="seq__c">{hero.line[2]}</span>
        </h1>
      </div>
    </div>
    <div class="wrap seq__after">
      <div class="seq__row">
        <p class="seq__lede" data-reveal="up">{hero.lede}</p>
        <div class="seq__ctas" data-reveal="up" data-delay="0.08">
          <Button href="#contact" label={site.cta} look="teal" />
          <Button href="#work" label="See the work" />
        </div>
      </div>
      <dl class="stats" data-reveal="up">
        {hero.stats.map((s) => <div class="stats__item"><dt>{s.label}</dt><dd>{s.value}</dd></div>)}
      </dl>
    </div>
  </section>

  <!-- LOGOS -->
  <section class="logos" aria-label="Brands we have worked with">
    <div class="logos__rail">
      <div class="logos__track">
        {[0, 1].map((copy) => (
          <ul class="logos__set" aria-hidden={copy === 1 ? 'true' : undefined}>
            {marquee.map((m) => (
              <li class="logos__item">
                {m.src ? <img src={m.src} alt={copy === 0 ? m.name : ''} width="140" height="48" loading="lazy" decoding="async" /> : <span>{m.name}</span>}
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  </section>

  <!-- ABOUT (day) -->
  <section class="sec about-sec" id="about" data-mood="day" aria-labelledby="about-title">
    <div class="wrap">
      <SecHead eyebrow={about.tag} id="about-title" lines={about.heading} />
      <!-- Wide, centred photo with a parallax window: the frame is fixed, the image inside drifts against the
           scroll (data-parallax), and the frame grows from inset to full width as it enters. -->
      <figure class="about__g" data-about-photo>
        <Image src={aboutPhoto} data-parallax="0.1" alt="The WiseUp and CodeAce team on stage at a brand launch event" widths={[760, 1200, 1600]} sizes="(max-width: 900px) 100vw, 90vw" loading="lazy" />
      </figure>
      <div class="about">
        <div class="about__l">
          <p class="contrast__statement" data-reveal="up">
            <span class="contrast__dim">{about.contrast.statement[0]}</span>
            <span class="contrast__bold">{about.contrast.statement[1]}</span>
          </p>
          <div class="contrast__rows" data-reveal="up">
          {about.contrast.rows.map((r) => (
            <p class="contrast__row">
              <span class="contrast__dim">{r.no}</span>
              <Icon name="arrow-r" size={18} class="contrast__arrow" />
              <span class="contrast__bold">{r.yes}</span>
            </p>
          ))}
          </div>
        </div>
        <p class="about__body" data-reveal="up">{about.body}</p>
      </div>
    </div>
  </section>

  <!-- PROCESS: horizontal scrolling gallery (pinned on desktop) -->
  <section class="sec hgal" id="process" aria-labelledby="process-title">
    <div class="hgal__view" data-hgal>
      <div class="hgal__track" data-hgal-track>
        <div class="hgal__intro">
          <SecHead eyebrow={process.tag} id="process-title" lines={process.heading} />
          <p class="hgal__hint" aria-hidden="true"><Icon name="arrow-r" size={16} />Keep scrolling</p>
        </div>
        <!-- proc__bg: a prompted abstract background per step (public/process/bg-N.jpg), a plain
             img tag rather than astro:assets, so a missing file never breaks the build. proc__shot:
             a real case-study photo placeholder filling the stage, until a per-step shot is picked. -->
        <ol class="hgal__list">
          {process.steps.map((s, i) => (
            <li class="card proc__card">
              <div class="proc__stage" aria-hidden="true">
                <img class="proc__bg" src={`/process/bg-${i + 1}.jpg`} alt="" width="960" height="720" loading="lazy" decoding="async" />
                <!-- Placeholder: a real case-study photo in place of an illustrative UI mock, until
                     a proper per-step visual is decided. -->
                <Image class="proc__shot" src={projects[i % projects.length].cover.src} alt="" widths={[400, 600]} sizes="(max-width: 767px) 92vw, 30vw" loading="lazy" />
              </div>
              <div class="proc__meta">
                <h3 class="proc__h"><span class="proc__n">{pad(i + 1)}</span>{s.title}</h3>
                <p>{s.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- SERVICES: rolling text drum + rows -->
  <section class="sec" id="services" aria-labelledby="services-title">
    <div class="wrap">
      <div class="svc-head">
        <SecHead eyebrow={services.tag} id="services-title" lines={services.heading} />
        <div class="drum" aria-hidden="true" data-drum>
          <div class="drum__ring" data-drum-ring>
            {services.drum.map((w, i) => <span class="drum__word" style={`--i:${i}`}>{w}</span>)}
          </div>
        </div>
      </div>
      <ul class="svc">
        {services.items.map((s, i) => (
          <li class="svc__item" data-reveal="up" data-delay={String(Math.min(i, 4) * 0.04)}>
            <h3>
              <button class="svc__btn" type="button" aria-expanded="false" aria-controls={`svc-${i}`} data-acc>
                <span class="svc__n">{pad(i + 1)}</span>
                <Icon name={s.icon} size={26} class="svc__ico" />
                <span class="svc__t">{s.title}</span>
                <span class="svc__dot" aria-hidden="true"></span>
              </button>
            </h3>
            <div class="svc__panel" id={`svc-${i}`} role="region" aria-label={s.title}>
              <div class="svc__inner"><ul class="chips">{s.tags.map((t) => <li>{t}</li>)}</ul></div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- CLIENTS: infinite looped panels -->
  <section class="sec" id="clients" aria-labelledby="clients-title">
    <div class="wrap">
      <div class="loop-head">
        <SecHead eyebrow={clients.tag} id="clients-title" lines={clients.heading} />
        <div class:list={['loop-nav', { 'loop-nav--fits-wide': clients.segments.length <= 4 }]}>
          <button class="loop-btn" type="button" aria-label="Previous segment" data-loop-prev><Icon name="chev-l" size={18} /></button>
          <button class="loop-btn" type="button" aria-label="Next segment" data-loop-next><Icon name="chev-r" size={18} /></button>
        </div>
      </div>
      <div class="loop" data-loop role="region" aria-roledescription="carousel" aria-label="Client segments">
        <ul class="loop__track" data-loop-track>
          {clients.segments.map((c, i) => (
            <li class:list={['card tier loop__panel', { 'tier--feat': c.featured }]} aria-roledescription="slide" aria-label={`${i + 1} of ${clients.segments.length}: ${c.title}`}>
              <p class="tier__n" aria-hidden="true">{pad(i + 1)}</p>
              {c.featured && <p class="tier__k">Most of our case studies</p>}
              <h3 class="tier__h">{c.title}</h3>
              <p class="tier__p">{c.text}</p>
              <Button href="#contact" label={site.ctaShort} look={c.featured ? 'teal' : 'night'} icon={false} block small />
              <ul class="ticks ticks--sm">{c.points.map((p) => <li><Icon name="check" size={18} />{p}</li>)}</ul>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- WORK: two rows of covers drifting in opposite directions (workRows() in motion/main.ts).
       Each row repeats one set of covers ROW_SETS times for a seamless loop; only the first set is
       focusable and announced, the copies are aria-hidden. -->
  <section class="sec" id="work" aria-labelledby="work-title">
    <div class="wrap">
      <SecHead eyebrow={work.tag} id="work-title" lines={work.heading} />
    </div>
    <div class="rows" data-reveal="up">
      {[rowA, rowB].map((row, r) => (
        <div class="rows__row" data-work-row data-dir={r === 0 ? '-1' : '1'}>
          <ul class="rows__track" data-sets={ROW_SETS}>
            {Array.from({ length: ROW_SETS }, (_, s) => row.map((p) => (
              <li class="rows__tile" aria-hidden={s > 0 ? 'true' : undefined}>
                <a class="rows__link" href={p.externalUrl} tabindex={s > 0 ? -1 : undefined} aria-label={`${p.title}, ${p.category}: view case study`}>
                  <Image src={p.cover.src} alt="" widths={[360, 540, 720]} sizes="(max-width: 640px) 72vw, 35vw" loading="lazy" />
                </a>
              </li>
            ))).flat()}
          </ul>
        </div>
      ))}
    </div>
    <div class="wrap">
      <div class="work-more">
        <Button href="https://wiseup.in/case-studies/" label="All case studies" look="teal" />
        <Button href="https://wiseup.in/studio/portfolio/" label="Full portfolio" />
      </div>
    </div>
  </section>

  <!-- CODEACE: dynamic morphing mark + cards -->
  <section class="sec" id="codeace" aria-labelledby="codeace-title">
    <div class="wrap">
      <div class="roots-head">
        <div>
          <SecHead eyebrow={codeace.tag} id="codeace-title" lines={codeace.heading} />
          <Button href={codeace.href} label="Visit codeace.com" icon="arrow-ur" small external />
        </div>
        <figure class="morph" aria-hidden="true" data-morph>
          <svg viewBox="0 0 200 200">
            <defs>
              <linearGradient id="morph-g" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#6fdcc9" />
                <stop offset="1" stop-color="#2a9d8f" />
              </linearGradient>
            </defs>
            <path d={shapeC} fill="url(#morph-g)" data-morph-path />
          </svg>
          <figcaption class="morph__label" data-morph-label>CodeAce</figcaption>
        </figure>
      </div>
      <ul class="roots">
        {codeace.cards.map((r, i) => (
          <li class="card root" data-reveal="up" data-delay={String(i * 0.07)}>
            <div class="root__who">
              <span class:list={['root__av', `root__av--${i}`]} aria-hidden="true">{r.mono}</span>
              <span><strong>{r.name}</strong><span>{r.role}</span></span>
            </div>
            <p class="root__text">{r.text}</p>
            <p class="root__mark">{r.mark}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="sec" id="faq" aria-labelledby="faq-title">
    <div class="wrap">
      <SecHead eyebrow={faq.tag} id="faq-title" lines={faq.heading} />
      <div class="faq" data-faq>
        {faq.items.map((f, i) => (
          <details class="faq__item" name="faq" data-reveal="up" data-delay={String(Math.min(i, 3) * 0.05)}>
            <summary class="faq__q"><h3>{f.q}</h3><span class="faq__dot" aria-hidden="true"></span></summary>
            <p class="faq__a">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACT: heading + socials left, a simple filled-box form right (placeholder-only fields,
       no visible label row) — matches the reference's contact split exactly. Still composes the
       same WhatsApp message on submit (contactForm() in motion/main.ts), just plainer styling. -->
  <section class="sec" id="contact" aria-labelledby="contact-title">
    <div class="wrap contact">
      <header class="contact__head">
        <SecHead eyebrow={contact.tag} id="contact-title" lines={contact.heading} />
        <p class="contact__p" data-reveal="up">{contact.body}</p>
      </header>
      <div class="contact__grid">
        <div class="contact__l">
        <ul class="cta-rows contact__rows" data-reveal="up">
          <li>
            <a class="cta-row" href={site.whatsapp} rel="noopener" target="_blank">
              <Icon name="whatsapp" size={22} class="cta-row__ico" />
              <span class="cta-row__body"><span class="cta-row__t">WhatsApp us</span><span class="cta-row__v">{site.phone}</span></span>
              <Icon name="arrow-ur" size={18} class="cta-row__go" />
            </a>
          </li>
          <li>
            <a class="cta-row" href={site.phoneHref}>
              <Icon name="phone" size={22} class="cta-row__ico" />
              <span class="cta-row__body"><span class="cta-row__t">Call us</span><span class="cta-row__v">{site.phone}</span></span>
              <Icon name="arrow-ur" size={18} class="cta-row__go" />
            </a>
          </li>
          <li>
            <a class="cta-row" href={`mailto:${site.email}?subject=Project%20enquiry`}>
              <Icon name="mail" size={22} class="cta-row__ico" />
              <span class="cta-row__body"><span class="cta-row__t">Email us</span><span class="cta-row__v">{site.email}</span></span>
              <Icon name="arrow-ur" size={18} class="cta-row__go" />
            </a>
          </li>
          <li>
            <span class="cta-row cta-row--static">
              <Icon name="globe" size={22} class="cta-row__ico" />
              <span class="cta-row__body"><span class="cta-row__t">Visit us</span><span class="cta-row__v">{site.city}</span></span>
            </span>
          </li>
        </ul>
        </div>
      <form class="bform" action={site.whatsapp} method="get" target="_blank" data-form data-reveal="up">
        <label class="bfield"><span>Full name</span><input name="name" autocomplete="name" placeholder="Full name" required /></label>
        <label class="bfield"><span>Email</span><input type="email" name="email" autocomplete="email" placeholder="Email address" required /></label>
        <label class="bfield"><span>Phone number</span><input type="tel" name="phone" autocomplete="tel" placeholder="Phone number" required /></label>
        <label class="bfield bfield--select"><span>Service</span>
          <select name="service" required>
            <option value="" selected disabled>Choose a service</option>
            {services.items.map((s) => <option value={s.title}>{s.title}</option>)}
          </select>
          <Icon name="chev-r" size={16} class="bfield__chev" />
        </label>
        <label class="bfield bfield--area"><span>Message</span><textarea name="text" rows="5" placeholder="Tell us where you want your brand to go." required></textarea></label>
        <Button type="submit" label="Send on WhatsApp" look="teal" icon="whatsapp" block />
        <p class="form__note">Opens WhatsApp with your message ready to send.</p>
      </form>
      </div>
      <ul class="socials" data-reveal="up">
          {site.socials.map((s) => <li><a class="social" href={s.href} rel="me noopener" target="_blank">{s.label}</a></li>)}
        </ul>
    </div>
  </section>

</Base>
